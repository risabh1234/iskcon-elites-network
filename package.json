{
  "name": "iskcon-elites-network",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "ci": "npm run check:design && npm run lint && npm run test:coverage && npm run build",
    "build:cloudflare": "npx @opennextjs/cloudflare build",
    "check:design": "node scripts/check-design-literals.mjs",
    "check:a11y": "node scripts/a11y-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "node scripts/patch-pg-cloudflare.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@prisma/adapter-pg": "^6.4.1",
    "@prisma/client": "^6.4.1",
    "@supabase/supabase-js": "^2.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.41.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "pg-cloudflare": "^1.4.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/noto-serif-devanagari": "^5.3.0",
    "@opennextjs/cloudflare": "^1.20.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "playwright": "^1.63.0",
    "prisma": "^6.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0",
    "wrangler": "^4.106.0"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
