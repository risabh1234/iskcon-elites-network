# ==============================================================================
# ISKCON Elites Network — Environment Configuration
# ==============================================================================

# Quotes below are for this file only. dotenv strips them; a hosting
# dashboard does not, so paste the VALUE into a dashboard field, without the
# surrounding quotes. (They are stripped defensively either way — see
# src/server/env-value.ts — but a URL still needs its https:// scheme.)

# 1. Supabase Postgres Database (Prisma)
# Obtain from Supabase: Project Settings -> Database -> Connection string -> URI
# Use Transaction Mode (port 6543) or Session Mode for DATABASE_URL
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL for Prisma migrations (port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. Supabase API & Storage
# Obtain from Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# 3. Authentication
# Sessions are first-party: email + password is built in and needs no keys.
# The site origin, used to build the OAuth redirect URI.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Sign-In (optional — the button is hidden until both are set).
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
#   Application type: Web application
#   Authorised redirect URI: <origin>/api/auth/google/callback
#   e.g. http://localhost:3000/api/auth/google/callback
#        https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 4. The console on its own subdomain (optional)
# Leave both blank until you have a domain: unset, the console stays at
# /admin on the main site and nothing below applies.
#
# NEXT_PUBLIC_ADMIN_HOST is a HOSTNAME, not a URL. With it set:
#   - admin.your-domain.com/           -> /admin
#   - admin.your-domain.com/directory  -> redirected to the public site
#   - your-domain.com/admin            -> redirected (308) to the subdomain
# Point the subdomain at the same deployment — one Worker serves both — and
# add https://admin.your-domain.com/api/auth/google/callback to the Google
# OAuth client's authorised redirect URIs if you use Google Sign-In.
NEXT_PUBLIC_ADMIN_HOST=""

# Scope the session cookie to the parent domain so one sign-in covers the site
# and the console. Note the leading dot. Leave blank on a single host: unset,
# the cookie is host-only, which is the safer default.
SESSION_COOKIE_DOMAIN=""

# 5. Optional / Cloudflare R2 or S3
S3_BUCKET_NAME=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
