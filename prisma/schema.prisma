generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "postgresql"
}

// ------------------------------------------------------
// 1. Identity & sessions (first-party; no external auth provider)
// ------------------------------------------------------
model User {
  id       String  @id @default(uuid())
  // Stored lower-cased so that a@Example.com and a@example.com are one person.
  email    String  @unique
  username String?
  name     String?

  // Null for accounts that only ever sign in with a social provider.
  // PBKDF2-HMAC-SHA256; see src/server/auth/password.ts for the encoding.
  passwordHash String?

  emailVerifiedAt DateTime?

  role            Role    @default(USER)
  canCreateEvents Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  // Audit relations
  alumni       Alumnus[]
  speakers     Speaker[]
  testimonials Testimonial[]
  events       Event[]

  @@index([role])
}

/// A social identity linked to a User. One row per provider per user.
model Account {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// An active sign-in.
///
/// The cookie carries a random token; only its SHA-256 hash is stored, so a
/// database leak does not hand out live sessions.
model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

enum Role {
 USER
 ADMIN
 SUPERADMIN
}

// ------------------------------------------------------
// 2. Core Domain Models
// ------------------------------------------------------
model Alumnus {
 id String @id @default(uuid())
 name String
 category String 
 cohort String
 bio String @db.Text
 avatarUrl String?
 videoUrl String?
 socialLinks Json? 
 email     String?  // optional contact email
 story     String?  @db.Text
 recommendation String? @db.Text
 addedById String
 addedBy User @relation(fields: [addedById], references: [id])
 isApproved Boolean @default(false)
 createdAt DateTime @default(now())
}

model Speaker {
 id String @id @default(uuid())
 name String
 title String
 bio String @db.Text
 avatarUrl String?
 email     String?  // optional contact email
 addedById String
 addedBy User @relation(fields: [addedById], references: [id])
 isApproved Boolean @default(false)
 createdAt DateTime @default(now())
}

 model Testimonial {
 id String @id @default(uuid())
 authorName String
 role String
 content String @db.Text
 videoUrl String?

 addedById String
 addedBy User @relation(fields: [addedById], references: [id])
 createdAt DateTime @default(now())
}

// ------------------------------------------------------
// 3. Events
// ------------------------------------------------------
 model Event {
 id String @id @default(uuid())
 title String
 location String
 date DateTime
 time String
 description String? @db.Text
 imageUrl String?
 isHighlighted Boolean @default(false)
 addedById String
 addedBy User @relation(fields: [addedById], references: [id])
 isApproved Boolean @default(false)
 createdAt DateTime @default(now())
}
